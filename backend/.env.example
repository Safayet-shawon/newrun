# Local development defaults
# MongoDB Community Server runs as a Windows service on the standard port.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nexora_local
JWT_SECRET=replace-with-a-long-random-secret
STORAGE_BACKEND=local
SEED_DEMO_DATA=false
ALLOW_DEV_SUBSCRIPTIONS=false
CORS_ORIGINS=http://localhost:3000

# Used when SEED_DEMO_DATA=true. Never use demo credentials in production.
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=change-me-for-production

# Optional wallet deposits. Default sandbox balances never mix with live balances.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Public HTTPS origin of the API, with no /api suffix. Required for provider IPN.
PAYMENT_CALLBACK_BASE_URL=
FRONTEND_URL=http://localhost:3000
