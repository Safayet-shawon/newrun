MONGO_URL=mongodb://127.0.0.1:27018/?replicaSet=nexora-local
DB_NAME=nexora_local
JWT_SECRET=replace-with-a-long-random-secret
STORAGE_BACKEND=local
SEED_DEMO_DATA=false
ALLOW_DEV_SUBSCRIPTIONS=false
CORS_ORIGINS=http://localhost:3000

# Optional wallet deposits. Default sandbox balances never mix with live balances.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Public HTTPS origin of the API, with no /api suffix. Required for provider IPN.
PAYMENT_CALLBACK_BASE_URL=
FRONTEND_URL=http://localhost:3000
