# ------------------------------------------------------------
# NEXORA environment template
# ------------------------------------------------------------
# Local development defaults are safe. For production, copy this file to .env
# on the server and replace every placeholder with real deployment values.

APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nexora_local
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_HOURS=24
REQUIRE_EMAIL_VERIFICATION=false

# Frontend / API origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=

# Set true only behind a trusted proxy/load balancer that overwrites forwarded
# headers. Never enable this merely because the app is public.
TRUST_PROXY_HEADERS=false
REFRESH_COOKIE_SAMESITE=lax

# Demo/dev switches: both must be false in production.
SEED_DEMO_DATA=false
ALLOW_DEV_SUBSCRIPTIONS=false
ADMIN_EMAIL=admin@nexora.com
ADMIN_PASSWORD=change-me-for-production

# ------------------------------------------------------------
# Global commerce
# ------------------------------------------------------------
DEFAULT_COUNTRY_CODE=BD
DEFAULT_CURRENCY=BDT
INTERNATIONAL_SHIPPING_ENABLED=true
DELIVERY_FEE_BDT=60
INTERNATIONAL_DELIVERY_FEE_BDT=1500
FREE_DELIVERY_OVER_BDT=2000

# Rates are expressed as 1 BDT = X target currency. Keep these fresh through
# deployment automation or a trusted FX provider. If omitted, only BDT display
# conversion is enabled. Example only; do not copy stale example rates live.
FX_RATES_JSON={"BDT":1}

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
# local | s3 | emergent
# Production readiness requires a durable non-local backend.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256

# Legacy/optional integration-backed storage
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=

# ------------------------------------------------------------
# Transactional email (verification + password reset)
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Nexora <no-reply@nexora.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Explicit Google/OIDC session exchange URL. In production, this must be set to
# the authorized authentication provider endpoint; the development demo fallback
# is disabled when APP_ENV=production.
GOOGLE_AUTH_SESSION_URL=

# ------------------------------------------------------------
# Customer wallet / SSLCommerz
# ------------------------------------------------------------
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Public HTTPS origin of the API, with no /api suffix. Required for provider IPN.
PAYMENT_CALLBACK_BASE_URL=

# Optional future international payment providers. Features should only be
# enabled after the relevant merchant account is approved and configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
